# Anthropic direct — the "anthropic" api mode enables their native /v1/messages
# format so we get first-class thinking blocks and cache_control markers,
# something the openai-completions bridge on OpenRouter can't fully expose.
anthropic_provider_json() {
  cat <<'EOF'
{
  "baseUrl": "https://api.anthropic.com/v1",
  "api": "anthropic",
  "apiKey": "$ANTHROPIC_API_KEY",
  "thinkingFormat": "anthropic",
  "models": [
    {
      "id": "claude-opus-4-7",
      "name": "Claude Opus 4.7",
      "reasoning": true,
      "input": ["text", "image"],
      "contextWindow": 200000,
      "maxTokens": 32000,
      "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
    },
    {
      "id": "claude-sonnet-4-6",
      "name": "Claude Sonnet 4.6",
      "reasoning": true,
      "input": ["text", "image"],
      "contextWindow": 200000,
      "maxTokens": 64000,
      "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
    },
    {
      "id": "claude-haiku-4-5-20251001",
      "name": "Claude Haiku 4.5",
      "reasoning": false,
      "input": ["text", "image"],
      "contextWindow": 200000,
      "maxTokens": 8192,
      "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
    }
  ]
}
EOF
}

