#!/command/with-contenv bashio
set -e

# Redirect stderr into stdout so both streams reach the s6 log service and
# show up together in the addon Logs tab. Otherwise pi-web crash traces and
# any node warnings disappear silently.
exec 2>&1

DATA_DIR=/data/pi-agent
mkdir -p "${DATA_DIR}/sessions"
MODELS_JSON="${DATA_DIR}/models.json"

# --- Auto-enable sidebar panel ---
# config.yaml's panel_title/panel_icon/panel_admin only supply *defaults*
# for the ingress_panel Supervisor state; the sidebar entry only sticks
# after "Show in sidebar" toggles ingress_panel=true. We flip it via the
# Supervisor API on every boot so a fresh install just works without the
# user hunting for the toggle on the addon Info page.
if [ -n "${SUPERVISOR_TOKEN}" ]; then
  if curl -sSL --max-time 5 -o /dev/null -w '%{http_code}' \
      -X POST \
      -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
      -H "Content-Type: application/json" \
      -d '{"ingress_panel": true}' \
      http://supervisor/addons/self/options 2>/dev/null | grep -q '^200$'; then
    bashio::log.info "Sidebar panel enabled via Supervisor API"
  else
    bashio::log.warning "Could not auto-enable sidebar — toggle 'Show in sidebar' manually if it's missing"
  fi
fi

# --- Config from HA UI (options.json) ---
bashio::config.require 'api_key'
GLM_API_KEY="$(bashio::config 'api_key')"
MINIMAX_API_KEY="$(bashio::config 'minimax_api_key' '')"
EXTRA_ALLOWED_HOSTS="$(bashio::config 'extra_allowed_hosts' '')"

# --- Provider snippet writers (stdout is a full provider object JSON) ---
glm_provider_json() {
  cat <<'EOF'
{
  "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
  "api": "openai-completions",
  "apiKey": "$GLM_API_KEY",
  "thinkingFormat": "zai",
  "models": [
    {
      "id": "glm-4.6",
      "name": "GLM-4.6",
      "reasoning": true,
      "input": ["text"],
      "contextWindow": 200000,
      "maxTokens": 16384,
      "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
    }
  ]
}
EOF
}

minimax_provider_json() {
  cat <<'EOF'
{
  "baseUrl": "https://api.minimax.io/v1",
  "api": "openai-completions",
  "apiKey": "$MINIMAX_API_KEY",
  "thinkingFormat": "deepseek",
  "models": [
    {
      "id": "MiniMax-M3",
      "name": "MiniMax M3",
      "reasoning": true,
      "input": ["text"],
      "contextWindow": 200000,
      "maxTokens": 16384,
      "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
    }
  ]
}
EOF
}

# --- Seed models.json on first ever start ---
if [ ! -f "${MODELS_JSON}" ]; then
  bashio::log.info "Bootstrapping ${MODELS_JSON} with GLM provider"
  printf '{"providers":{"glm":%s}}' "$(glm_provider_json)" > "${MODELS_JSON}"
fi

# --- Idempotently ensure MiniMax provider exists when the key is set. ---
# User edits to models.json survive: we only add if the "minimax" key is
# missing. If the user has renamed / removed it deliberately, we honor that.
if [ -n "${MINIMAX_API_KEY}" ] && [ "${MINIMAX_API_KEY}" != "null" ]; then
  if ! jq -e '.providers.minimax' "${MODELS_JSON}" > /dev/null 2>&1; then
    bashio::log.info "Adding minimax provider (MiniMax-M3, openai-completions, thinkingFormat=deepseek)"
    tmp="$(mktemp)"
    jq --argjson mm "$(minimax_provider_json)" \
       '.providers.minimax = $mm' "${MODELS_JSON}" > "${tmp}"
    mv "${tmp}" "${MODELS_JSON}"
  fi
fi

# --- Provider startup self-check ---
# Curl GLM once with max_tokens=1. Non-fatal — a bad key shouldn't prevent
# the UI from booting (user needs to open Configuration to fix it), but
# without this the failure was silent and only visible after clicking Send.
bashio::log.info "Checking GLM provider reachability..."
GLM_CODE="$(curl -sSL --max-time 10 -o /dev/null -w '%{http_code}' \
  -X POST \
  -H "Authorization: Bearer ${GLM_API_KEY}" \
  -H "Content-Type: application/json" \
  -d '{"model":"glm-4.6","messages":[{"role":"user","content":"1"}],"max_tokens":1}' \
  https://open.bigmodel.cn/api/paas/v4/chat/completions 2>/dev/null || echo 000)"
case "${GLM_CODE}" in
  200)
    bashio::log.info "GLM provider OK (HTTP ${GLM_CODE})"
    ;;
  401|403)
    bashio::log.warning "GLM auth failed (HTTP ${GLM_CODE}) — fix 'api_key' in Configuration tab"
    ;;
  000)
    bashio::log.warning "GLM unreachable — check network / DNS from container"
    ;;
  *)
    bashio::log.warning "GLM returned unexpected HTTP ${GLM_CODE} — chat may fail until fixed"
    ;;
esac

# --- Runtime env for pi-web ---
export GLM_API_KEY
export MINIMAX_API_KEY
export PI_CODING_AGENT_DIR="${DATA_DIR}"
export PI_WEB_HOSTNAME="0.0.0.0"
export PI_WEB_NO_OPEN=1
export PORT=30141

# pi-web auto-accepts IP literals and loopback names. Only override if the
# user browses via a custom hostname behind a reverse proxy.
if [ -n "${EXTRA_ALLOWED_HOSTS}" ] && [ "${EXTRA_ALLOWED_HOSTS}" != "null" ]; then
  export PI_WEB_ALLOWED_HOSTS="${EXTRA_ALLOWED_HOSTS}"
  bashio::log.info "PI_WEB_ALLOWED_HOSTS=${PI_WEB_ALLOWED_HOSTS}"
fi

bashio::log.info "Starting pi-web on 0.0.0.0:30141 (data: ${PI_CODING_AGENT_DIR})"
exec pi-web
